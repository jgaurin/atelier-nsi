---
// Squelette commun à toutes les pages : en-tête, navigation (barre du bas sur téléphone), pied de page.
// La navigation principale, ce sont les deux objectifs : cliquer sur l'un le choisit et ouvre son parcours.
import "katex/dist/katex.min.css";
import "../styles/global.css";
import { iconeHTML } from "../scripts/icones";

interface Props {
  titre: string;
  description?: string;
  /** Objectif mis en avant dans la navigation quelle que soit la préférence (les épreuves relèvent du CAPES). */
  objectifPage?: "capes";
}

const { titre, description = "Se préparer à enseigner NSI et SNT : entretien de professeur contractuel et CAPES externe NSI.", objectifPage } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4a3dce" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icones/icone-apple-180.png" />
    <meta name="apple-mobile-web-app-title" content="Atelier NSI" />
    <title>{titre === "Atelier NSI" ? titre : `${titre} · Atelier NSI`}</title>
    <script is:inline>
      (function () {
        var choix = null;
        try { choix = localStorage.getItem("atelier-nsi:theme"); } catch (e) {}
        var sombre = choix ? choix === "sombre" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = sombre ? "sombre" : "clair";
      })();
    </script>
  </head>
  <body data-objectif-page={objectifPage}>
    <a class="visuellement-cache" href="#contenu">Aller au contenu</a>
    <header class="entete">
      <a class="marque" href="/parcours/" aria-label="Atelier NSI, mon parcours">
        <span class="marque-logo" aria-hidden="true">&gt;_</span>
        <span>Atelier NSI<small>Enseigner NSI et SNT</small></span>
      </a>
      <nav class="nav-principale" aria-label="Objectifs">
        <a href="/parcours/?objectif=contractuel" data-nav-objectif="contractuel">Professeur contractuel</a>
        <a href="/parcours/?objectif=capes" data-nav-objectif="capes">CAPES NSI</a>
      </nav>
      <div class="nav-outils">
        <button type="button" data-basculer-theme title="Mode clair / sombre" aria-label="Basculer entre mode clair et mode sombre"><Fragment set:html={iconeHTML("theme", 18)} /></button>
        <a href="/reglages/" aria-current={Astro.url.pathname.startsWith("/reglages") ? "page" : undefined} title="Sauvegarde et réglages" aria-label="Sauvegarde et réglages"><Fragment set:html={iconeHTML("reglages", 18)} /></a>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied">
      <span>Atelier NSI — se préparer à enseigner NSI et SNT : entretien de professeur contractuel et CAPES externe NSI (session 2027).</span>
      <a href="/parcours/programme/">Couverture du programme officiel</a>
    </footer>

    <nav class="nav-mobile" aria-label="Objectifs">
      <a href="/parcours/?objectif=contractuel" data-nav-objectif="contractuel"><Fragment set:html={iconeHTML("mallette", 20)} />Contractuel</a>
      <a href="/parcours/?objectif=capes" data-nav-objectif="capes"><Fragment set:html={iconeHTML("diplome", 20)} />CAPES NSI</a>
      <a href="/reglages/" aria-current={Astro.url.pathname.startsWith("/reglages") ? "page" : undefined}><Fragment set:html={iconeHTML("reglages", 20)} />Réglages</a>
    </nav>

    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
