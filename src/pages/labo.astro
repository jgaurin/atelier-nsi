---
// Labo : tester librement du Python ou du SQL, sans exercice.
import Base from "../layouts/Base.astro";
import { readdirSync } from "node:fs";

const bases = readdirSync("public/bases").filter((f) => f.endsWith(".sql")).map((f) => f.replace(/\.sql$/, ""));
---
<Base titre="Labo" rubrique="labo">
  <div class="page page-etroite">
    <div class="surtitre">Labo</div>
    <h1>Essayer du code librement</h1>
    <p class="chapeau">Un bac à sable pour tester une idée, vérifier une trace ou préparer une réalisation pour l'oral. Rien n'est noté.</p>

    <section class="carte" style="margin-top:1.5rem" data-labo="python">
      <h2 style="margin-top:0;font-size:1.2rem">Python</h2>
      <div data-editeur></div>
      <div class="exercice-actions"><button type="button" class="bouton bouton-petit" data-executer>▶ Exécuter</button><span class="editeur-aide">Ctrl + Entrée · ton code est gardé sur cet appareil · pas de <code>input()</code> : mets les valeurs dans des variables.</span></div>
      <div class="resultat" data-sortie aria-live="polite"></div>
    </section>

    <section class="carte" style="margin-top:1.5rem" data-labo="sql">
      <h2 style="margin-top:0;font-size:1.2rem">SQL</h2>
      <label style="display:flex;gap:.5rem;align-items:center;font-size:.92rem;margin-bottom:.6rem">Base :
        <select data-base style="padding:.35rem .6rem;border-radius:8px;border:1px solid var(--bord-fort);background:var(--surface)">
          {bases.map((b) => <option value={b}>{b}</option>)}
        </select>
      </label>
      <details class="schema-base" data-schema><summary>Voir les tables</summary></details>
      <div data-editeur style="margin-top:.6rem"></div>
      <div class="exercice-actions"><button type="button" class="bouton bouton-petit" data-executer>▶ Exécuter</button><span class="editeur-aide">La base repart de zéro à chaque exécution : tu peux tout casser.</span></div>
      <div class="resultat" data-sortie aria-live="polite"></div>
    </section>
  </div>
  <script>
    import "../scripts/labo";
  </script>
</Base>
