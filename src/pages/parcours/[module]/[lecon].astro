---
// Page d'une leçon. L'ordre est toujours le même :
// objectifs → cours (schémas, code) → exemple guidé → l'essentiel → exercices → validation.
import Base from "../../../layouts/Base.astro";
import ListeLecons from "../../../components/ListeLecons.astro";
import { render } from "astro:content";
import { chargerParcours, leconsEcrites, voisines } from "../../../lib/parcours";
import { synchroConfiguree } from "../../../data/synchro";
import { iconeHTML } from "../../../scripts/icones";

export async function getStaticPaths() {
  const modules = await chargerParcours();
  return modules.flatMap((m) => m.ecrites.map((l) => ({ params: { module: m.id, lecon: l.slug }, props: { cle: l.cle } })));
}

const { cle } = Astro.props;
const modules = await chargerParcours();
const module = modules.find((m) => m.id === cle.split("/")[0])!;
const lecon = module.ecrites.find((l) => l.cle === cle)!;
const entree = lecon.entree!;
const { Content, headings } = await render(entree);
const { precedente, suivante } = await voisines(cle);
const toutes = await leconsEcrites();
const prerequis = entree.data.prerequis.map((c) => toutes.find((l) => l.cle === c)).filter((l) => l !== undefined);
const sommaire = headings.filter((h) => h.depth === 2);
const idsExercices = lecon.exercices.map((e) => e.id);
const parNiveau = [1, 2, 3, 4].map((n) => lecon.exercices.filter((e) => e.niveau === n).length);
---
<Base titre={lecon.titre} description={lecon.resume}>
  <div class="lecon-grille" style={`--teinte: ${module.teinte}`}>
    <aside class="lecon-module" aria-label={`Leçons du module ${module.titre}`}>
      <a class="module-titre" href={module.url}><span class="pastille-module"></span>{module.titre}</a>
      <ListeLecons module={module} courante={cle} />
    </aside>

    <article class="lecon-corps" data-lecon={cle} data-partie={module.partie}>
      <header class="lecon-tete">
        <nav class="fil-ariane" aria-label="Fil d'Ariane">
          <a href="/parcours/">Parcours</a><span aria-hidden="true">›</span><a href={module.url}>{module.titre}</a>
        </nav>
        <div class="surtitre">Leçon {lecon.numero} sur {module.lecons.length}</div>
        <h1>{lecon.titre}</h1>
        <p class="chapeau">{lecon.resume}</p>
        <div class="puces">
          <span class="puce">⏱ {lecon.duree} min</span>
          {lecon.exercices.length > 0 && <span class="puce">{lecon.exercices.length} exercices corrigés</span>}
          {parNiveau[3] > 0 && <span class="puce puce-accent">{parNiveau[3]} de type concours</span>}
          <span class="puce statut-texte" data-statut-lecon={cle}></span>
        </div>
        <section class="objectifs">
          <h2>À la fin de cette leçon, tu sauras</h2>
          <ul>{entree.data.objectifs.map((o) => <li set:html={o.replace(/`([^`]+)`/g, "<code>$1</code>")} />)}</ul>
          {prerequis.length > 0 && (
            <p class="prerequis">Avant de commencer : {prerequis.map((p, i) => <>{i > 0 && " · "}<a href={p!.url}>{p!.titre}</a></>)}</p>
          )}
        </section>
        <details class="sommaire-mobile">
          <summary>Les leçons de « {module.titre} »</summary>
          <ListeLecons module={module} courante={cle} />
        </details>
      </header>

      <div class="contenu">
        <Content />
      </div>

      {synchroConfiguree && (
        <section class="carte ia-outils" data-ia-outils>
          <div class="ia-outils-tete">
            <span class="ia-pastille" set:html={iconeHTML("etincelles", 15)} />
            <div>
              <h2>S'entraîner avec l'IA</h2>
              <p>À la demande, sur cette leçon.</p>
            </div>
          </div>
          <div class="onglets" role="tablist" aria-label="Outils d'entraînement avec l'IA">
            {module.partie !== "enseigner" && (
              <button type="button" role="tab" id={`onglet-exos-${cle}`} aria-controls={`panneau-exos-${cle}`} aria-selected="false" data-onglet>
                <span set:html={iconeHTML("inserer", 16)} />Exercices en plus
                <span class="onglet-compte" data-exos-ia-compte hidden></span>
              </button>
            )}
            <button type="button" role="tab" id={`onglet-oral-${cle}`} aria-controls={`panneau-oral-${cle}`} aria-selected="false" data-onglet>
              <span set:html={iconeHTML("micro", 16)} />{module.partie === "enseigner" ? "Face au jury" : "À l'oral"}
            </button>
          </div>

          {module.partie !== "enseigner" && (
            <div class="onglet-panneau exos-ia" role="tabpanel" id={`panneau-exos-${cle}`} aria-labelledby={`onglet-exos-${cle}`} hidden data-exos-ia={cle}>
              <p class="exos-ia-intro">
                Choisis un niveau : l'IA crée un exercice Python sur cette leçon, avec ses tests, des indices et un corrigé.
                L'Atelier vérifie que son corrigé passe ses tests avant de te le montrer.
              </p>
              <div class="exos-ia-commande">
                <div class="choix-niveau" role="radiogroup" aria-label="Niveau de l'exercice">
                  <button type="button" role="radio" data-niveau="1" aria-checked="false">Découverte</button>
                  <button type="button" role="radio" data-niveau="2" aria-checked="true">Entraînement</button>
                  <button type="button" role="radio" data-niveau="3" aria-checked="false">Approfondissement</button>
                  <button type="button" role="radio" data-niveau="4" aria-checked="false">Type concours</button>
                </div>
                <button type="button" class="bouton" data-exos-ia-generer>
                  <span set:html={iconeHTML("etincelles", 16)} />
                  Créer un exercice
                </button>
              </div>
              <p class="exos-ia-etat" data-exos-ia-etat role="status" aria-live="polite"></p>
              <details class="exos-ia-liste" data-exos-ia-liste hidden>
                <summary><span set:html={iconeHTML("chevron", 16)} />Exercices générés <span class="exos-ia-nombre" data-exos-ia-nombre>0</span></summary>
                <div class="exos-ia-exercices" data-exos-ia-exercices></div>
              </details>
            </div>
          )}

          <div class="onglet-panneau oral" role="tabpanel" id={`panneau-oral-${cle}`} aria-labelledby={`onglet-oral-${cle}`} hidden data-oral={cle}>
            <div class="oral-accueil" data-oral-accueil>
              <p>
                {module.partie === "enseigner"
                  ? "L'IA joue le jury : une question sur ce thème, des relances comme en entretien, puis un bilan."
                  : "L'IA te pose une question sur une notion de cette leçon. Explique comme devant une classe : elle te relance, puis te fait un bilan."}
              </p>
              <ul class="oral-etapes">
                <li><span set:html={iconeHTML("micro", 16)} />À voix haute ou au clavier</li>
                <li><span set:html={iconeHTML("fleche", 16)} />Une ou deux relances</li>
                <li><span set:html={iconeHTML("etoile", 16)} />Un bilan noté sur 5</li>
              </ul>
              <button type="button" class="bouton" data-oral-demarrer>
                <span set:html={iconeHTML("etincelles", 16)} />
                Me poser une question
              </button>
            </div>
            <div class="oral-fil" data-oral-fil></div>
          </div>
        </section>
      )}

      <section class="validation" data-validation={cle}>
        <h2 data-validation-titre>As-tu bien compris cette leçon ?</h2>
        <p>
          {idsExercices.length > 0 && <>Exercices réussis : <strong data-exercices-reussis={JSON.stringify(idsExercices)}>0 / {idsExercices.length}</strong>. </>}
          Valide la leçon quand tu sais refaire les exercices sans regarder le corrigé.
        </p>
        <div class="boutons">
          <button type="button" class="bouton bouton-vert" data-valider>Je valide cette leçon</button>
          {suivante && <a class="bouton bouton-second" href={suivante.url}>Leçon suivante →</a>}
        </div>
      </section>

      <nav class="suite" aria-label="Leçons précédente et suivante">
        {precedente && <a class="carte carte-lien" href={precedente.url}><small>← Précédente</small>{precedente.titre}</a>}
        {suivante && <a class="carte carte-lien suivante" href={suivante.url}><small>Suivante →</small>{suivante.titre}</a>}
      </nav>
    </article>

    <aside class="lecon-sommaire" aria-label="Sur cette page">
      <div class="sommaire-titre">Sur cette page</div>
      <ol class="sommaire-liste">
        {sommaire.map((h) => (
          <li class={h.slug === "exercices" ? "sommaire-exercices" : undefined}><a href={`#${h.slug}`} data-cible={h.slug}>{h.text}</a></li>
        ))}
      </ol>
    </aside>
  </div>

  <script>
    import "../../../scripts/lecon";
    import "../../../scripts/oral";
    import "../../../scripts/exos-ia";
    import "../../../scripts/onglets";
  </script>
</Base>
