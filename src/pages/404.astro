---
import Base from "../layouts/Base.astro";
---
<Base titre="Page introuvable">
  <div class="page page-etroite" style="text-align:center;padding-top:4rem">
    <div class="surtitre">Erreur 404</div>
    <h1>Cette page n'existe pas (ou pas encore)</h1>
    <p class="chapeau" style="margin-inline:auto">La leçon que tu cherches est peut-être encore en rédaction.</p>
    <a class="bouton" href="/parcours/">Retour au parcours</a>
  </div>
</Base>
