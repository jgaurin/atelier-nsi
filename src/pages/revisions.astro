---
// Révisions espacées : les cartes des leçons validées reviennent juste avant d'être oubliées.
import Base from "../layouts/Base.astro";
import { chargerParcours } from "../lib/parcours";
import { enLigne, hachage } from "../lib/texte";

const modules = await chargerParcours();
const cartes = modules.flatMap((m) => m.ecrites.flatMap((l) => l.entree!.data.cartes.map((c) => ({
  id: `${l.cle}#${hachage(c.q)}`,
  lecon: l.cle,
  module: m.id,
  titreModule: m.titre,
  titreLecon: l.titre,
  url: l.url,
  q: enLigne(c.q),
  r: enLigne(c.r),
}))));
const modulesAvecCartes = modules.filter((m) => cartes.some((c) => c.module === m.id));
---
<Base titre="Révisions" rubrique="revisions">
  <div class="page page-etroite">
    <div class="surtitre">Révisions espacées</div>
    <h1>Ne rien oublier d'ici le concours</h1>
    <p class="chapeau">
      Quand tu valides une leçon, ses cartes arrivent ici. Chaque carte revient après un délai qui s'allonge
      quand tu la connais bien, et revient vite quand tu l'as oubliée. Quelques minutes par jour suffisent.
    </p>

    <section class="carte" data-revisions={JSON.stringify(cartes)} style="margin:1.5rem 0">
      <div class="chiffres" style="margin-bottom:1rem">
        <div class="chiffre"><strong data-nb-dues>0</strong><span>cartes à revoir aujourd'hui</span></div>
        <div class="chiffre"><strong data-nb-nouvelles>0</strong><span>nouvelles cartes disponibles</span></div>
        <div class="chiffre"><strong data-nb-suivies>0</strong><span>cartes en mémoire</span></div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:.6rem;align-items:center">
        <button type="button" class="bouton" data-demarrer>Commencer la séance</button>
        <label style="display:flex;gap:.5rem;align-items:center;font-size:.92rem;color:var(--texte-2)">
          ou réviser un module :
          <select data-module style="padding:.4rem .6rem;border-radius:8px;border:1px solid var(--bord-fort);background:var(--surface)">
            <option value="">— leçons validées —</option>
            {modulesAvecCartes.map((m) => <option value={m.id}>{m.titre}</option>)}
          </select>
        </label>
      </div>
      <p data-vide style="margin:1rem 0 0;color:var(--texte-3);font-size:.92rem" hidden>
        Aucune carte pour l'instant : valide une leçon (en bas de chaque leçon) pour ajouter ses cartes, ou choisis un module ci-dessus.
      </p>
    </section>

    <section class="carte carte-revision" data-seance hidden aria-live="polite">
      <div class="origine" data-origine></div>
      <div class="question-carte" data-question></div>
      <div class="reponse-carte" data-reponse hidden></div>
      <div style="margin-top:auto">
        <button type="button" class="bouton" data-montrer style="width:100%">Afficher la réponse <kbd>Espace</kbd></button>
        <div class="notes-revision" data-notes hidden>
          <button type="button" class="bouton bouton-second" data-note="0">À revoir<small data-delai="0"></small></button>
          <button type="button" class="bouton bouton-second" data-note="1">Difficile<small data-delai="1"></small></button>
          <button type="button" class="bouton bouton-second" data-note="2">Bien<small data-delai="2"></small></button>
          <button type="button" class="bouton bouton-second" data-note="3">Facile<small data-delai="3"></small></button>
        </div>
      </div>
      <div class="origine" data-reste></div>
    </section>

    <section class="carte" data-fin hidden style="text-align:center">
      <h2 style="margin-top:0">Séance terminée</h2>
      <p data-fin-texte>Reviens demain pour les prochaines cartes.</p>
      <a class="bouton bouton-second" href="/parcours/">Retour au parcours</a>
    </section>
  </div>

  <script>
    import "../scripts/revisions";
  </script>
</Base>
